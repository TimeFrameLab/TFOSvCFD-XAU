# UPDATE and CANDIDATE require XLSX-export link access. Never expose a workbook
# containing personal/portfolio data; use a sanitized copy instead.
# UPDATE and CANDIDATE download this spreadsheet snapshot to ./downloads.
SET_DATA_URL=
SET_DATA_SHEET=All-SET-MTFS

# Optional, read-only Settrade market data. Never put your PIN or account number here.
# Requires App ID and App Secret from Settrade Open API; values stay local in .env.
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_BROKER_ID=SANDBOX
SETTRADE_APP_CODE=SANDBOX
